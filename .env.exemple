# Copier en .env et renseigner. Ne JAMAIS versionner ce fichier.

# Signature des cookies de session. À générer : openssl rand -hex 32
PORTAIL_SECRET=

# Jeton de l'API Proxmox, rôle limité au cycle de vie d'un clone.
PROXMOX_TOKEN=
PROXMOX_URL=https://10.0.20.1:8006/api2/json
VMID_MODELE=9002

# Clé partagée avec Guacamole — 32 caractères hexadécimaux exactement.
JSON_SECRET_KEY=

# Guacamole ne publie son port que sur la boucle locale de l'hôte : le joindre
# par son nom sur son réseau Docker.
GUAC_URL=http://guacamole:8080/guacamole

# Le portail ne joint QUE l'agent snippet.
AGENT_SNIPPET_HOTE=enclave-agent@10.0.20.1

# Dette du prototype : certificat Proxmox auto-signé.
NODE_TLS_REJECT_UNAUTHORIZED=1
